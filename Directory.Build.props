<Project>
  <!--
    Shared build settings for every SDK-style project under the repo root:
    the plain-C# simulation (src/) and its xUnit tests (tests/).
    The Sim must be bit-reproducible across machines (simulation-core GDD),
    so builds are deterministic and culture-invariant.
    Configuration names are keyed in exactly one place: the Export* groups
    below map Godot's ExportRelease / ExportDebug onto Optimize (Godot's SDK
    maps them only for the Godot project itself, so a referenced plain-SDK
    project would otherwise stay unoptimised). Everything else - including the
    SIM_ASSERT switch in Directory.Build.targets - keys on $(Optimize) or
    $(SimAsserts), never on Configuration (ADR-0001 section 4).
    Note: when the Godot .NET build is installed, the Godot-generated root
    .csproj will also import this file; review TreatWarningsAsErrors /
    EnforceCodeStyleInBuild for it then.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Export* -> Optimize mapping (ADR-0001 section 4). -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize Condition="'$(Optimize)' == ''">true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ExportDebug'">
    <Optimize Condition="'$(Optimize)' == ''">false</Optimize>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
  </PropertyGroup>
</Project>
