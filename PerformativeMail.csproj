<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PerformativeMail</RootNamespace>
    <AssemblyName>PerformativeMail</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Only the Godot-facing folders compile here; Sim / Server / Client are their own Godot-free libraries. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/App/**/*.cs" />
    <Compile Include="src/Client/Presentation/**/*.cs" />
    <Compile Include="src/Client/UI/**/*.cs" />
    <Compile Include="src/Client/Input/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/Sim/PerformativeMail.Sim.csproj" />
    <ProjectReference Include="src/Server/PerformativeMail.Server.csproj" />
    <ProjectReference Include="src/Client/PerformativeMail.Client.csproj" />
  </ItemGroup>

</Project>
