<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Determinism analyzer for the authoritative Sim (ADR-0006 section 3, rule 1:
    no float / double / decimal / Half). A Roslyn analyzer MUST target
    netstandard2.0. Referenced from src/PerformativeMail.Sim as an analyzer:
      <ProjectReference ... OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    Microsoft.CodeAnalysis.CSharp is pinned to a version no newer than the
    compiler shipped with SDK 10.0.402 (5.0.x line), otherwise the compiler
    refuses to load the analyzer. 4.8.0 loads on every SDK from 8.0.100 up.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PerformativeMail.Sim.Analyzers</AssemblyName>
    <RootNamespace>PerformativeMail.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
